{
  "name": "Latch – Passwort-Manager",
  "short_name": "Latch",
  "description": "Passwort-Manager, der deine Zugangsdaten verschlüsselt nur auf deinem Gerät speichert.",
  "lang": "de",
  "id": "/app/",
  "start_url": "/app/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f0f2ee",
  "theme_color": "#173a2f",
  "categories": ["security", "utilities", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Passwortgenerator", "url": "/app/generator/", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Sicherheitsbericht", "url": "/app/report/", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
